// Generated by rn-new-arch-migrate from .rn-new-arch/migration-manifest.json.
// Re-applies native customizations captured before `npx expo prebuild --clean`.
// Originals live in .rn-new-arch/extracted-native/ (commit that folder or move files you need).
const { withAndroidManifest, withInfoPlist, withAppBuildGradle, withPodfile, withDangerousMod } = require('expo/config-plugins');
const fs = require('fs');
const path = require('path');

const OVERLAY = __OVERLAY_JSON__;
const MARK = '// rn-new-arch-migrate overlay';

module.exports = function restoreNativeOverlay(config) {
  config = withAndroidManifest(config, (c) => {
    const m = c.modResults.manifest;
    m['uses-permission'] = m['uses-permission'] || [];
    for (const p of OVERLAY.androidPermissions) {
      if (!m['uses-permission'].some((u) => u.$['android:name'] === p)) m['uses-permission'].push({ $: { 'android:name': p } });
    }
    const app = m.application?.[0];
    if (app) {
      app['meta-data'] = app['meta-data'] || [];
      for (const { name, value } of OVERLAY.androidMetaData) {
        if (!app['meta-data'].some((x) => x.$['android:name'] === name)) app['meta-data'].push({ $: { 'android:name': name, 'android:value': value } });
      }
    }
    return c;
  });
  if (OVERLAY.gradleExtras.length) {
    config = withAppBuildGradle(config, (c) => {
      if (!c.modResults.contents.includes(MARK)) {
        c.modResults.contents = c.modResults.contents.replace(/dependencies\s*\{/, (m) => `${m}\n    ${MARK}\n    ${OVERLAY.gradleExtras.join('\n    ')}\n`);
      }
      return c;
    });
  }
  config = withInfoPlist(config, (c) => {
    const p = c.modResults;
    for (const [k, v] of Object.entries(OVERLAY.infoPlist)) if (p[k] === undefined) p[k] = v;
    if (OVERLAY.urlSchemes.length) {
      p.CFBundleURLTypes = p.CFBundleURLTypes || [];
      const have = p.CFBundleURLTypes.flatMap((t) => t.CFBundleURLSchemes || []);
      const missing = OVERLAY.urlSchemes.filter((s) => !have.includes(s));
      if (missing.length) p.CFBundleURLTypes.push({ CFBundleURLSchemes: missing });
    }
    if (OVERLAY.backgroundModes.length) p.UIBackgroundModes = Array.from(new Set([...(p.UIBackgroundModes || []), ...OVERLAY.backgroundModes]));
    if (OVERLAY.queriesSchemes.length) p.LSApplicationQueriesSchemes = Array.from(new Set([...(p.LSApplicationQueriesSchemes || []), ...OVERLAY.queriesSchemes]));
    return c;
  });
  if (OVERLAY.podExtras.length) {
    config = withPodfile(config, (c) => {
      if (!c.modResults.contents.includes('# rn-new-arch-migrate overlay')) {
        c.modResults.contents = c.modResults.contents.replace(/(use_expo_modules!|use_native_modules!)/, (m) => `${m}\n  # rn-new-arch-migrate overlay\n  ${OVERLAY.podExtras.join('\n  ')}`);
      }
      return c;
    });
  }
  for (const platform of ['android', 'ios']) {
    config = withDangerousMod(config, [platform, async (c) => {
      const root = c.modRequest.projectRoot;
      for (const rel of OVERLAY.files[platform] || []) {
        const src = path.join(root, '.rn-new-arch/extracted-native', rel);
        const dst = path.join(root, rel);
        if (fs.existsSync(src) && !fs.existsSync(dst)) {
          fs.mkdirSync(path.dirname(dst), { recursive: true });
          fs.copyFileSync(src, dst);
        }
      }
      return c;
    }]);
  }
  return config;
};
